# ---------------------------------------------------------------------------
# VoltCalc environment. Copy to `.env.local` and fill in as you enable features.
# The app RUNS WITHOUT ANY OF THESE — calculators + panel schedule work offline.
# Each block below lights up an additional capability.
# ---------------------------------------------------------------------------

# --- AI code-search assistant (Anthropic Claude) -------------------------
# Without this, /api/chat returns a helpful stub. With it, the assistant answers
# with CEC citations. Voyage powers embeddings for RAG grounding (later).
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
VOYAGE_API_KEY=

# --- Database (Postgres + pgvector) --------------------------------------
# Enables auth, saved projects/history, subscriptions/metering and RAG storage.
# Neon (recommended) or any Postgres with the `vector` extension.
DATABASE_URL=

# --- Auth.js / NextAuth ---------------------------------------------------
AUTH_SECRET=            # generate: npx auth secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Stripe (subscriptions + free-tier metering) -------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
